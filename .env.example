# NestFinder — Environment Variables Example
# Copy to .env and fill in values.

# PostgreSQL (Neon). Use the POOLED (-pooler) connection string for Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require"

# PostgreSQL (production) — swap schema.prisma provider to "postgresql" too
# DATABASE_URL="postgresql://user:password@host:5432/nestfinder?sslmode=require"

# Auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
